#!/usr/bin/env bash
#
# hk-watch-location.sh — 通过 USB/iAP2 向获批测试设备发送模拟坐标
#
# 用法：
#   ./hk-watch-location.sh              # 一键执行完整流程（默认香港坐标，15 分钟会话）
#   ./hk-watch-location.sh 22.2810 114.1588   # 自定义坐标
#   ./hk-watch-location.sh send         # 只发送（跳过已完成的安装步骤）
#   ./hk-watch-location.sh stop         # 停止发送，恢复手机真实定位
#
# 运行前提：
#   1. macOS + 已安装 uv（无则脚本自动安装）
#   2. iPhone 通过 USB 连接 Mac，已解锁并"信任此电脑"
#   3. 仅在获批的测试应用中触发定位请求
#
set -euo pipefail

# ========================= 可配置参数 =========================
DEFAULT_LAT=22.3193          # 纬度
DEFAULT_LON=114.1694         # 经度
DURATION=900                 # 单轮会话时长（秒）；发送循环执行，直到用户按 Ctrl+C 或到达 30 分钟上限
MAX_TOTAL=1800               # 持续发送总时长上限（秒）= 30 分钟，到达后自动终止并输出结果解读
# 组件包：主包（accessory-location 脚本/源码 + identity MFi 证书）
#          + 按平台独立的 lib 包（依赖 wheel），脚本按 CPU 架构自动选择
BUNDLE_DIR="/tmp/hk-watch-location-bundle"
BASE_URL="https://github.com/siruoren/hk-watch-location/releases/download/v1"
BUNDLE_URL="${BASE_URL}/hk-watch-location-bundle.zip"
# 按平台选择 lib 包（arm64 / x86_64）
case "$(uname -m)" in
    arm64) LIB_NAME="hk-watch-location-lib-macos-arm64.zip" ;;
    *)     LIB_NAME="hk-watch-location-lib-macos-x86_64.zip" ;;
esac
LIB_URL="${BASE_URL}/${LIB_NAME}"
PYPI_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple"
# GitHub 加速代理地址（按顺序尝试，全部失效后才回退 GitHub 直连）
GH_MIRRORS=(
    "https://ghfast.top/"
    "https://wget.la/"
    "https://gh-proxy.com/"
    "https://ghproxy.net/"
    "https://ghproxy.cc/"
    "https://gh-proxy.net/"
)
# 整个代理列表的完整轮次：代理全部失败 → 直连 → 仍失败再来一轮（共 2 轮）
DOWNLOAD_ROUNDS=2
SEND_LOG="/tmp/send_hk.log"
DOCTOR_LOG="/tmp/doctor_hk.log"

c_info()  { printf '\033[1;34m[信息]\033[0m %s\n' "$*"; }
c_ok()    { printf '\033[1;32m[完成]\033[0m %s\n' "$*"; }
c_warn()  { printf '\033[1;33m[注意]\033[0m %s\n' "$*"; }
c_err()   { printf '\033[1;31m[错误]\033[0m %s\n' "$*"; }

# ========================= 子命令：stop =========================
do_stop() {
    c_info "停止所有发送进程..."
    pkill -f "accessory-location send" 2>/dev/null || true
    pkill -f "local_mfi_v3_helper"    2>/dev/null || true
    sleep 1
    # 兜底：按 PID 强杀
    local pids
    pids=$(ps aux | grep -E "accessory-location send|local_mfi_v3_helper" | grep -v grep | awk '{print $2}' || true)
    if [ -n "$pids" ]; then
        kill -9 $pids 2>/dev/null || true
        sleep 1
    fi
    if ps aux | grep -E "accessory-location send|local_mfi_v3_helper" | grep -v grep >/dev/null; then
        c_err "仍有进程残留，请手动检查: ps aux | grep accessory"
    else
        c_ok "发送进程已全部停止，USB 会话已断开"
    fi
    echo
    c_warn "恢复手机真实定位，请在 iPhone 上操作："
    echo "  1. 拔掉 USB 线"
    echo "  2. 设置 → 隐私与安全性 → 定位服务 → 关闭 10 秒后再打开"
    echo "  3. 打开地图重新定位，确认蓝点回到真实位置"
}

# ========================= 步骤 1：环境检查 =========================
check_env() {
    c_info "步骤 1/5：检查环境"

    if [ "$(uname)" != "Darwin" ]; then
        c_err "此脚本仅支持 macOS"; exit 1
    fi

    if ! command -v uv >/dev/null 2>&1; then
        c_warn "未安装 uv，正在安装..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        export PATH="${HOME}/.local/bin:${PATH}"
    fi
    c_ok "uv $(uv --version | awk '{print $2}')"

    # 检查 iPhone 是否通过 USB 连接
    if system_profiler SPUSBDataType 2>/dev/null | grep -qi "iphone"; then
        c_ok "检测到 iPhone 已通过 USB 连接"
    else
        c_warn "未检测到 iPhone！请确认：已用数据线连接、已解锁、已点'信任此电脑'"
        c_warn "（脚本继续执行，但发送阶段会失败）"
        read -r -p "按回车继续，或 Ctrl-C 退出..."
    fi
}

# ========================= 步骤 2：下载组件包 =========================
# 通用下载：fetch <URL> <目标文件> <最小字节数> [超时秒数，默认900，lib包传3600=1小时]
# 流程：先用每个代理做 10 秒测速（拉取前 256KB），10 秒内通过才参与下载，未通过自动换下一个；
#       通过测速的代理依次带实时百分比进度下载；全部失效回退 GitHub 直连（同样带进度）；
#       仍失败再来一轮，共 DOWNLOAD_ROUNDS 轮；全部失败返回 1，由调用方决定降级（如在线安装）
PROBE_TIMEOUT=10      # 代理测速限时（秒）
PROBE_BYTES=262144    # 测速拉取的前缀字节数（256KB）

# dl <URL> <目标文件> <最小字节数> <超时秒数>：带实时百分比进度下载
# （curl -# 进度条直接写入终端 stderr，不加管道缓冲，保证前台实时显示百分比）
dl() {
    rm -f "$2"
    curl -L --progress-bar --connect-timeout 15 --max-time "$4" --retry 3 --retry-delay 2 \
         -o "$2" -H "User-Agent: hk-watch-location" "$1"
    [ -f "$2" ] && [ "$(stat -f%z "$2" 2>/dev/null || echo 0)" -gt "$3" ]
}

fetch() {
    local url="$1" dest="$2" min_size="$3" timeout="${4:-900}" ok=1 round m
    for round in $(seq 1 "${DOWNLOAD_ROUNDS}"); do
        [ "$round" -gt 1 ] && c_warn "上一轮下载全部失败，开始第 ${round} 轮重试..."
        # 阶段 1：代理测速——10 秒内拉不到前 256KB 的代理直接跳过
        local -a fast_proxies=()
        for m in "${GH_MIRRORS[@]}"; do
            c_info "  测速代理: ${m}（${PROBE_TIMEOUT} 秒内需拉取前 ${PROBE_BYTES} 字节）"
            local code
            code=$(curl -sL --connect-timeout 5 --max-time "$PROBE_TIMEOUT" \
                        -r "0-$((PROBE_BYTES - 1))" -o /dev/null -w '%{http_code}' \
                        -H "User-Agent: hk-watch-location" "${m}${url}" 2>/dev/null || echo 000)
            if [ "$code" = "200" ] || [ "$code" = "206" ]; then
                c_ok "  测速通过: ${m}"
                fast_proxies+=("$m")
            else
                c_warn "  测速未通过（${PROBE_TIMEOUT} 秒内未完成），跳过: ${m}"
            fi
        done
        # 阶段 2：用通过测速的代理依次下载（带实时百分比进度）；macOS bash 3.2 下空数组展开会
        # 触发 set -u 的 unbound variable，故先判空
        if [ "${#fast_proxies[@]}" -gt 0 ]; then
            for m in "${fast_proxies[@]}"; do
                c_info "  代理下载: ${m}"
                if dl "${m}${url}" "$dest" "$min_size" "$timeout"; then
                    ok=0; c_ok "  下载成功 ($(stat -f%z "$dest") 字节)"; break
                fi
                c_warn "  该代理下载失败，换下一个..."
            done
        fi
        # 阶段 3：全部失效 → GitHub 直连（带实时百分比进度）
        if [ "$ok" -ne 0 ]; then
            c_warn "全部可用代理失效（测速未通过或下载失败），回退 GitHub 直连..."
            if dl "$url" "$dest" "$min_size" "$timeout"; then
                ok=0; c_ok "  直连下载成功 ($(stat -f%z "$dest") 字节)"
            fi
        fi
        [ "$ok" -eq 0 ] && break
    done
    [ "$ok" -eq 0 ] && return 0
    rm -f "$dest"   # 全部失败：清理残留的部分下载文件
    c_err "代理与直连共 ${DOWNLOAD_ROUNDS} 轮重试均失败（每次超时 ${timeout} 秒），请手动下载 ${url} 后重试"
    return 1
}

# 主包是否就绪（脚本 + 证书；lib 可缺失，缺时依赖走在线安装）
bundle_ready() {
    [ -f "${BUNDLE_DIR}/accessory-location/tools/local_mfi_v3_helper.py" ] \
        && [ -f "${BUNDLE_DIR}/identity/certificate.p7b" ] \
        && [ -f "${BUNDLE_DIR}/identity/identity.pk8" ]
}

setup_bundle() {
    c_info "步骤 2/5：准备组件包（脚本 + 证书 + 本平台 lib）"

    if [ -x "${BUNDLE_DIR}/.venv/bin/accessory-location" ]; then
        c_ok "组件包与依赖已就绪：${BUNDLE_DIR}"
        return
    fi

    # --- 主包（脚本 + 证书），下载失败则无法继续；下载/解压失败自动清理重下，最多 10 次 ---
    if ! bundle_ready; then
        local bundle_zip="/tmp/hk-watch-location-bundle.zip"
        local btry=0
        while [ "$btry" -lt 10 ]; do
            btry=$((btry + 1))
            # 本地缓存损坏（下载中断的半截文件或代理返回的错误页）→ 删除重下
            if [ -f "$bundle_zip" ] && ! unzip -tqq "$bundle_zip" </dev/null >/dev/null 2>&1; then
                c_warn "本地缓存的主包损坏，删除后重新下载"
                rm -f "$bundle_zip"
            fi
            if [ ! -f "$bundle_zip" ]; then
                c_info "下载主组件包（脚本 + 证书）...（第 $btry/10 次）"
                if ! fetch "${BUNDLE_URL}" "$bundle_zip" 50000 \
                    || ! unzip -tqq "$bundle_zip" </dev/null >/dev/null 2>&1; then
                    rm -f "$bundle_zip"
                    if [ "$btry" -lt 10 ]; then c_warn "主包下载失败或损坏，自动重试..."; continue; fi
                fi
            fi
            [ -f "$bundle_zip" ] || break
            c_info "解压主组件包到 ${BUNDLE_DIR} ..."
            mkdir -p "${BUNDLE_DIR}"
            if unzip -q "$bundle_zip" -d "${BUNDLE_DIR}" 2>/dev/null && bundle_ready; then
                c_ok "主组件包就绪：${BUNDLE_DIR}（证书已随包提供，无需再解析 APK）"
                break
            fi
            rm -rf "${BUNDLE_DIR}"; rm -f "$bundle_zip"
            if [ "$btry" -lt 10 ]; then
                c_warn "主包解压失败或内容不完整（可能是下载损坏），已清理，自动重新下载（第 $btry/10 次）..."
            fi
        done
        bundle_ready || { c_err "主组件包连续 10 次下载/解压均失败；请检查网络/代理，并确认 Release 资产为无密码 zip 后重试"; exit 1; }
    else
        c_ok "主组件包已存在：${BUNDLE_DIR}"
    fi

    # --- 本平台 lib 包；网络持续不可用时跳过，由步骤 3 自动在线安装依赖 ---
    if ! ls "${BUNDLE_DIR}/lib/"*.whl >/dev/null 2>&1; then
        local lib_zip="/tmp/${LIB_NAME}"
        # 本地缓存损坏（如下载中断的半截文件）→ 删除后重新下载
        if [ -f "$lib_zip" ] && ! unzip -tqq "$lib_zip" </dev/null >/dev/null 2>&1; then
            c_warn "本地缓存的 lib 包损坏，删除后重新下载"
            rm -f "$lib_zip"
        fi
        if [ ! -f "$lib_zip" ]; then
            c_info "下载本平台 lib 包：${LIB_NAME}（自动检测架构：$(uname -m)）..."
            local tries=0
            while [ "$tries" -lt 2 ]; do
                if fetch "${LIB_URL}" "$lib_zip" 10000000 3600 \
                    && unzip -tqq "$lib_zip" </dev/null >/dev/null 2>&1; then
                    break
                fi
                tries=$((tries + 1))
                rm -f "$lib_zip"
                [ "$tries" -lt 2 ] && c_warn "lib 包下载失败或损坏（可能是下载中断），重试（第 2/2 次）..."
            done
            if [ ! -f "$lib_zip" ]; then
                c_warn "lib 包下载失败（网络不可用或持续损坏），将改为在线安装依赖"
                return 0
            fi
        fi
        c_info "解压 lib 包到 ${BUNDLE_DIR}/lib ..."
        mkdir -p "${BUNDLE_DIR}/lib"
        unzip -q "$lib_zip" -d "${BUNDLE_DIR}/lib" \
            || { c_warn "lib 包解压异常，将改为在线安装依赖"; rm -rf "${BUNDLE_DIR}/lib"; rm -f "$lib_zip"; return 0; }
        ls "${BUNDLE_DIR}/lib/"*.whl >/dev/null 2>&1 \
            && c_ok "lib 包就绪（$(ls "${BUNDLE_DIR}/lib/"*.whl | wc -l | tr -d ' ') 个 wheel）" \
            || { c_warn "lib 包解压异常，将改为在线安装依赖"; rm -rf "${BUNDLE_DIR}/lib"; rm -f "$lib_zip"; }
    fi
}

# ========================= 步骤 3：安装依赖（优先 lib/ 离线，缺 lib 时在线） =========================
setup_deps() {
    c_info "步骤 3/5：安装依赖（Python 3.12）"

    export UV_PYTHON_INSTALL_MIRROR="${GH_MIRRORS[0]}https://github.com/astral-sh/python-build-standalone/releases/download"

    # venv 健康检查：入口缺失或核心导入失败视为残缺（上次运行被中断），清理重建
    local healthy=0
    if [ -x "${BUNDLE_DIR}/.venv/bin/accessory-location" ] \
        && "${BUNDLE_DIR}/.venv/bin/python" -c "import cryptography, pymobiledevice3" >/dev/null 2>&1; then
        healthy=1
        c_ok "依赖已就绪（导入验证通过）"
    fi
    if [ "$healthy" -eq 0 ]; then
        if [ -d "${BUNDLE_DIR}/.venv" ]; then
            c_warn "现有 .venv 残缺（可能是上次运行被中断），清理后重建..."
            rm -rf "${BUNDLE_DIR}/.venv"
        fi
        local vtry
        for vtry in 1 2; do
            uv venv --python 3.12 "${BUNDLE_DIR}/.venv"
            if ls "${BUNDLE_DIR}/lib/"*.whl >/dev/null 2>&1; then
                # 优先纯离线安装（lib/ 内含本平台全部 wheel）
                if ! uv pip install --python "${BUNDLE_DIR}/.venv" --no-index \
                     --find-links "${BUNDLE_DIR}/lib" accessory-location==0.1.0; then
                    c_warn "离线安装失败，改用镜像在线补齐缺失组件..."
                    if ! UV_HTTP_TIMEOUT=600 UV_INDEX_URL="${PYPI_MIRROR}" \
                            uv pip install --python "${BUNDLE_DIR}/.venv" \
                            "${BUNDLE_DIR}/accessory-location"; then
                        c_warn "在线安装也失败，将清理 venv 后重试..."
                    fi
                fi
            else
                # lib 包未下载成功（网络不可用）：直接在线安装（包内源码 + 镜像拉依赖）
                c_warn "lib/ 无 wheel，改为在线安装依赖（使用清华镜像）..."
                if ! UV_HTTP_TIMEOUT=600 UV_INDEX_URL="${PYPI_MIRROR}" \
                        uv pip install --python "${BUNDLE_DIR}/.venv" \
                        "${BUNDLE_DIR}/accessory-location"; then
                    c_warn "在线安装失败，将清理 venv 后重试..."
                fi
            fi
            if "${BUNDLE_DIR}/.venv/bin/python" -c "import cryptography, pymobiledevice3" >/dev/null 2>&1; then
                break
            fi
            rm -rf "${BUNDLE_DIR}/.venv"
            [ "$vtry" -lt 2 ] && c_warn "安装后验证未通过（venv 可能仍残缺），已清理重试..."
        done
    fi
    "${BUNDLE_DIR}/.venv/bin/python" -c "import cryptography, pymobiledevice3" \
        && c_ok "依赖安装并导入验证通过"
}

# ========================= 步骤 4：发送坐标 =========================
do_send() {
    local lat="${1:-${DEFAULT_LAT}}" lon="${2:-${DEFAULT_LON}}"

    c_info "步骤 4/5：发送坐标 (${lat}, ${lon})，会话 ${DURATION} 秒"

    # pymobiledevice3 需要此目录（本次实测：不存在时会 PermissionError）
    mkdir -p "${HOME}/.pymobiledevice3"

    # 确认 iPhone 连接
    if ! system_profiler SPUSBDataType 2>/dev/null | grep -qi "iphone"; then
        c_err "未检测到 iPhone，请连接 USB 后重试"; exit 1
    fi

    # 证书/私钥直接使用组件包内的 identity 目录
    export ACCESSORY_MFI_CERT_FILE="${BUNDLE_DIR}/identity/certificate.p7b"
    export ACCESSORY_MFI_KEY_FILE="${BUNDLE_DIR}/identity/identity.pk8"
    export PATH="${BUNDLE_DIR}/.venv/bin:${PATH}"

    cd "${BUNDLE_DIR}/accessory-location"
    : > "${SEND_LOG}"   # 每次执行重建日志（多轮 tee -a 累加写入）
    c_info "启动 USB 会话，日志：${SEND_LOG}"
    echo "-----------------------------------------------------------"
    c_warn "请仅在获批的测试应用中触发定位请求；不要用于改变真实位置或获取受限服务资格"
    echo "-----------------------------------------------------------"

    # 持续运行：每轮 DURATION 秒（末轮自动缩短以不超上限），轮与轮无缝衔接；
    # 用户按 Ctrl+C 手动停止，或累计达 MAX_TOTAL（30 分钟）自动终止
    set +e
    trap 'c_warn "收到停止信号，结束持续发送..."; send_running=0' INT TERM
    local round=1 send_running=1 rc=0
    local start=$SECONDS elapsed=0 dur
    while [ "$send_running" -eq 1 ]; do
        elapsed=$((SECONDS - start))
        [ "$elapsed" -ge "$MAX_TOTAL" ] && break
        # 末轮时长取剩余时间，保证总时长不超过 30 分钟
        dur=$DURATION
        [ "$((elapsed + DURATION))" -gt "$MAX_TOTAL" ] && dur=$((MAX_TOTAL - elapsed))
        c_info "第 ${round} 轮发送会话（${dur} 秒/轮，按 Ctrl+C 随时停止，总上限 ${MAX_TOTAL} 秒）"
        "${BUNDLE_DIR}/.venv/bin/accessory-location" send --transport usb \
            --auth-helper "${BUNDLE_DIR}/accessory-location/tools/local_mfi_v3_helper.py" \
            --latitude "$lat" --longitude "$lon" --interval 1 --duration "$dur" 2>&1 | tee -a "${SEND_LOG}"
        rc=${PIPESTATUS[0]}
        if [ "$send_running" -eq 1 ] && [ "$rc" -ne 0 ]; then
            c_warn "会话异常退出（代码 ${rc}），5 秒后自动重试下一轮..."
            sleep 5
        fi
        [ "$send_running" -eq 1 ] && round=$((round + 1))
    done
    trap - INT TERM
    set -e
    if [ "$send_running" -eq 0 ]; then
        c_ok "发送已手动停止（共完成 ${round} 轮，日志：${SEND_LOG}）"
    else
        c_ok "持续发送已达 ${MAX_TOTAL} 秒（30 分钟）上限，自动终止（共 ${round} 轮，日志：${SEND_LOG}）"
    fi
}

# ========================= 步骤 5：结果解读 =========================
report() {
    c_info "步骤 5/5：会话结果解读"
    echo
    if grep -q "authentication_succeeded" "${SEND_LOG}" 2>/dev/null; then
        c_ok "MFi 认证成功"
    else
        c_err "未见认证成功事件，检查证书与 USB 连接"
    fi
    if grep -q "location_requested" "${SEND_LOG}" 2>/dev/null; then
        c_ok "手机已发起定位请求（订阅 GGA+RMC）"
    else
        c_warn "未收到定位请求 → 请检查获批测试应用及 USB 会话状态"
    fi
    local ack
    ack=$(grep -o '"location_link_acknowledged", "count": [0-9]*' "${SEND_LOG}" 2>/dev/null | tail -1 | grep -o '[0-9]*$' || echo 0)
    if [ "${ack:-0}" -gt 0 ]; then
        c_ok "手机确认收到 ${ack} 个坐标包（送达≠采纳，以地图蓝点为准）"
    else
        c_warn "无确认包，检查手机端操作"
    fi
    # 采纳诊断：发送频率受协议 1Hz 上限约束；蓝点仅在手机端应用活跃请求定位时更新
    local req stp
    req=$(grep -c '"location_requested"' "${SEND_LOG}" 2>/dev/null || true)
    stp=$(grep -c '"location_stopped"' "${SEND_LOG}" 2>/dev/null || true)
    if [ "${stp:-0}" -gt 0 ]; then
        c_warn "手机端在会话中 ${req} 次请求 / ${stp} 次暂停定位订阅——暂停期间 iOS 不消费坐标"
        echo "  若地图蓝点未更新，请确认：①获批应用在前台且正在显示地图/蓝点；②定位服务中该应用权限为'使用期间'并开启'精确位置'；③手机已解锁"
    else
        c_ok "手机端持续处于定位订阅状态（${req} 次请求，0 次暂停）"
    fi
    echo
    c_info "测试结束后运行本脚本 stop，并确认设备已恢复真实定位。"
    c_warn "坐标包送达不代表系统或应用采纳，也不代表任何服务资格。"
}

# ========================= 诊断：获批应用资格/前台状态 =========================
# 用 probe 会话（只监听不发坐标）检测手机端是否有获批应用在请求定位，并给出针对性结论
do_doctor() {
    c_info "运行 20 秒诊断会话（probe 只监听不发坐标），检测手机端定位订阅状态..."

    mkdir -p "${HOME}/.pymobiledevice3"
    if ! system_profiler SPUSBDataType 2>/dev/null | grep -qi "iphone"; then
        c_err "未检测到 iPhone，请连接 USB（解锁并信任）后重试"; exit 1
    fi

    export ACCESSORY_MFI_CERT_FILE="${BUNDLE_DIR}/identity/certificate.p7b"
    export ACCESSORY_MFI_KEY_FILE="${BUNDLE_DIR}/identity/identity.pk8"
    export PATH="${BUNDLE_DIR}/.venv/bin:${PATH}"

    cd "${BUNDLE_DIR}/accessory-location"
    : > "${DOCTOR_LOG}"
    set +e
    "${BUNDLE_DIR}/.venv/bin/accessory-location" probe --transport usb \
        --auth-helper "${BUNDLE_DIR}/accessory-location/tools/local_mfi_v3_helper.py" \
        --duration 20 2>&1 | tee "${DOCTOR_LOG}"
    set -e

    echo
    c_info "诊断结论（获批应用资格 / 前台状态）："
    if grep -q '"authentication_succeeded"' "${DOCTOR_LOG}" 2>/dev/null; then
        c_ok "1. MFi 证书认证通过 —— 附件侧资格正常"
    else
        c_err "1. 认证失败 —— 检查 identity/ 证书与 USB 连接，此项不过则无从谈起定位"
        return 1
    fi

    local req stp
    req=$(grep -c '"location_requested"' "${DOCTOR_LOG}" 2>/dev/null || true)
    stp=$(grep -c '"location_stopped"' "${DOCTOR_LOG}" 2>/dev/null || true)
    if [ "${req:-0}" -gt 0 ] && [ "${stp:-0}" -gt 0 ]; then
        c_warn "2. 手机端有获批应用但为轮询式请求（${req} 次请求 / ${stp} 次暂停）"
        echo "   → 前台状态不稳：应用可能切到后台或锁屏。处理：保持该应用前台显示地图蓝点、手机全程解锁、关闭低电量模式"
    elif [ "${req:-0}" -gt 0 ]; then
        c_ok "2. 手机端获批应用持续请求定位（${req} 次，无暂停）—— 资格与前台状态正常"
        echo "   → 此状态下发送坐标，蓝点应更新；若仍不更新，检查该应用定位权限'精确位置'是否开启"
    else
        c_err "2. 整个会话手机端从未请求定位 —— 获批应用未在前台运行或无 accessory location 资格"
        echo "   → 处理：①在 iPhone 上打开获批测试应用并停留在地图页再诊断一次；②设置>隐私与安全性>定位服务：该应用权限'使用期间'+'精确位置'；③定位服务总开关需开启；④若手机上没有可用获批应用，需为该应用申请 accessory location 相关资格后重新安装"
    fi
}

# ========================= 主流程 =========================
main() {
    case "${1:-}" in
        stop)
            do_stop
            exit 0
            ;;
        doctor)
            bundle_ready || { c_err "主组件包未就绪，请先执行完整流程: $0 run"; exit 1; }
            [ -x "${BUNDLE_DIR}/.venv/bin/accessory-location" ] || { c_err "依赖未安装，请先执行完整流程: $0 run"; exit 1; }
            do_doctor
            exit 0
            ;;
        send)
            bundle_ready || { c_err "主组件包未就绪，请先执行完整流程: $0 run"; exit 1; }
            [ -x "${BUNDLE_DIR}/.venv/bin/accessory-location" ] || { c_err "依赖未安装，请先执行完整流程: $0 run"; exit 1; }
            mkdir -p "${HOME}/.pymobiledevice3"
            do_send "${2:-}" "${3:-}"
            report
            exit 0
            ;;
        ""|run)
            local lat="${2:-${DEFAULT_LAT}}" lon="${3:-${DEFAULT_LON}}"
            check_env
            setup_bundle
            setup_deps
            do_send "$lat" "$lon"
            report
            ;;
        *)
            echo "用法: $0 [run|send|stop|doctor] [纬度] [经度]"
            echo "  run  (默认) 完整流程：环境检查 → 下载组件包 → 离线装依赖 → 持续发送（Ctrl+C 停止）"
            echo "  send        直接持续发送（跳过安装步骤，Ctrl+C 停止）"
            echo "  doctor      20 秒诊断：检测手机端获批应用的资格与前台状态"
            echo "  stop        停止发送并指导恢复真实定位"
            exit 1
            ;;
    esac
}

main "$@"
